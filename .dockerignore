# Build context excludes for the AquaZeroFit API image.
# The build context is the monorepo root (see apps/api/Dockerfile), so without
# this file every local artifact would be shipped to the daemon.

# Secrets - never enter the build context
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example

# Dependencies - installed fresh by npm ci inside the image
node_modules
**/node_modules

# VCS and CI metadata
.git
.gitignore
.gitattributes
.github
.claude
.cursor
.windsurf
.aider*
.artifacts
.codex
.gemini
.antigravity

# Runtime content - mounted via volumes at runtime, never baked in
data/
apps/api/uploads/
apps/api/.data/
uploads/

# Test and coverage output
coverage/
**/coverage/
*.lcov

# Host web dist is stale relative to this build. The image runs vite itself.
apps/web/dist/

# Documentation and design assets - not needed at runtime
docs/
design/
content/
evals/
tools/
# prompts/ is NOT excluded: the API loads the P-*.md prompt files at boot.

# Reports and planning artifacts. prompts/*.md must survive: loadPrompt reads
# them at boot, and a pattern without a slash matches in every directory.
*.md
!README.md
!LICENSE
!prompts/
!prompts/**
!prompts/*.md

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# The Android app. Gradle build, never COPYed by apps/api/Dockerfile, and
# ~326 MB of sources, build output and 209 MB of exercise media that was
# being streamed to the Docker daemon as build context on every single build.
apps/android/

# Public edge. Deployed with wrangler, not baked into the API image.
cloudflare/
