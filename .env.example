# ============================================================
# AquaZeroFit - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your real keys.
#   cp .env.example .env
#
# NEVER commit your real .env file. It is gitignored.
# ============================================================

# --- App Runtime ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins.
# REQUIRED in production, must be https, and must not contain "*".
# The API refuses to boot otherwise (platform/config.ts assertProductionSecrets).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Proxy hops to trust for req.ip / X-Forwarded-For.
# 0 locally (no proxy). Behind Azure Container Apps / App Service ingress use 1,
# and 2 if Front Door sits in front of that. Getting this wrong collapses every
# caller into one rate-limit bucket and locks out all logins.
# Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Stamped by CI (commit SHA) and returned by /health and /ready.
# APP_VERSION=
# Local JSON store directory (default: apps/api/.data).
# Used ONLY when DATABASE_URL is unset. Never rely on this in a hosted
# environment: Replit's filesystem resets on every publish.
# AZF_DATA_DIR=

# --- Persistence ---
# Postgres connection string. Replit injects this automatically once you add a
# database to the App; setting it switches the store from JSON files to
# Postgres. Development and production use SEPARATE databases on Replit.
# Leave blank locally to keep using the JSON store.
DATABASE_URL=

# --- Docker Compose stack (docker-compose.yml) ---
# Required by docker compose up - the stack REFUSES to start when these are
# unset. DATABASE_URL is assembled from these inside compose; do not also set
# DATABASE_URL above when running the compose stack.
POSTGRES_USER=postgres
# Placeholder ONLY - replace with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=aquazerofit

# --- Single-origin hosting ---
# The API also serves the built SPA from apps/web/dist, so one deployment
# serves the whole product on one port and one domain. Set SERVE_WEB=false for
# an API-only deployment; WEB_DIST_DIR overrides where the build is found.
# SERVE_WEB=true
# WEB_DIST_DIR=
# Seed demo data on first boot (set to false to skip)
AZF_SEED_DEMO=true
# Echo password-reset tokens in API responses and server logs (dev only).
# Requires NODE_ENV != production AND EXPOSE_DEV_TOKENS=true. Default off so
# staging never leaks reset credentials via logs or response bodies.
# EXPOSE_DEV_TOKENS=false
# Where in-flight meal photographs are written (default apps/api/uploads).
# On a host with an ephemeral filesystem (Replit resets it on every publish)
# point this at a mounted persistent volume, or a redeploy loses photos that
# are mid-analysis.
# UPLOADS_DIR=

# --- Mail (REQUIRED in production) ---
# Password reset mints a token and mails it. Without a real transport the token
# goes nowhere, the endpoint still answers 202, and a user who forgets their
# password is locked out for good — so the API refuses to boot in production
# until these are set (platform/config.ts assertProductionSecrets).
#
# Transport selection: MAIL_PROVIDER if set, else `memory` under test, else
# `resend` when RESEND_API_KEY is present, else `console` (prints the message).
# MAIL_PROVIDER=console
# API key from https://resend.com — its presence selects the resend transport.
RESEND_API_KEY=
# Envelope sender. MUST be a domain verified with the provider, or every
# message is silently dropped on the provider's side.
MAIL_FROM=AquaZeroFit <no-reply@localhost>
# Public origin of the app; reset links in mail are built from it.
APP_PUBLIC_URL=http://localhost:5173
# Optional LLM second stage for input guardrails (P-09 safetyCheap lane).
# Defaults ON when any real AI provider key is configured, OFF when keyless.
# Set true|false to override (platform/config.ts enableLlmSafety).
# ENABLE_LLM_SAFETY=

# --- Security (REQUIRED in production) ---
# Generate with: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
# Admin account password for production seed (admin@aquazero.fit).
# REQUIRED to create the admin account in production; no default is used there.
# In development, seeds demo + admin when AZF_SEED_DEMO is not false; defaults to
# AquaZeroAdmin!2026 when unset. Never commit a real production password here.
# ADMIN_PASSWORD=
# Telegram bot token for Mini App launch-data validation. Also the credential
# the Stars payment flow uses: coach purchases stay switched off (the roster
# reports starsAvailable=false and the buy buttons never render) while this is
# the dev placeholder, because calling Telegram with it would 401 on every call.
TELEGRAM_BOT_TOKEN=dev-bot-token

# Shared secret Telegram echoes back on every webhook delivery, set via the
# `secret_token` parameter of setWebhook. REQUIRED before coach purchases can
# complete: /api/v1/telegram/webhook is unauthenticated and grants entitlements,
# so it rejects every request while this is empty rather than trusting them all.
# Generate one with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# Refuse plaintext http and redirect it to https (platform/https.ts).
# On by default in production, off otherwise — there is no TLS on localhost.
# Set false ONLY when a sidecar has already terminated TLS and this container
# genuinely serves plaintext on a private network, where redirecting to https
# would point at an origin that does not listen.
# FORCE_HTTPS=

# --- Bot protection (Cloudflare Turnstile) ---
# Guards POST /auth/register and POST /auth/password-reset/request — the two
# unauthenticated routes a botnet actually wants (one mints accounts and AI
# credits, the other mails an address the caller chose). Rate limiting alone
# does not stop a distributed signup flood: a thousand addresses each stay
# under the per-IP lane. Sign-in is deliberately NOT challenged.
#
# BOTH are read by the API at runtime. The site key is public and is handed to
# the browser by GET /api/v1/auth/captcha — deliberately NOT a VITE_ build-time
# constant, because a build-time key is missed silently (the widget simply
# never renders and the form ships unprotected) and cannot be rotated without
# rebuilding the client.
# Keys: https://dash.cloudflare.com -> Turnstile -> Add site
#
# Setting only ONE leaves protection OFF and logs `bot_protection_half_configured`.
# That is deliberate: a secret without a site key would make the server demand a
# token the browser is never told to produce, locking everyone out of signup.
# Both unset disables the check entirely — what development, the test suite and
# the keyless offline demo need; production then logs `bot_protection_disabled`
# rather than refusing to start.
#
# Turnstile scopes a site key to the hostnames listed on the widget in the
# Cloudflare dashboard. Add every origin that serves the form — the production
# domain AND any Replit preview/dev URL — or the widget fails on the ones you
# left out.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# --- AI Provider Keys ---
# All keys are optional in development - the gateway falls back to a
# deterministic offline engine when no provider keys are configured.
# Put in only the keys you have; the gateway auto-detects which are present.

# Azure OpenAI / Microsoft Foundry (planned, NOT wired in gateway.ts yet).
# The gateway currently uses Groq, OpenAI, Gemini, NVIDIA, and Ollama only.
# These vars are reserved for a future Azure provider; setting them has no effect
# today. See docs/specs/AQF-21 for the deployment plan.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# NVIDIA NIM / build.nvidia.com API (https://build.nvidia.com/)
NVIDIA_API_KEY=
# NVIDIA NIM base URL (OpenAI-compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama (local or hosted - https://ollama.com)
OLLAMA_API_KEY=
# Base URL for Ollama server (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Frontend (Vite, apps/web) ---
# Read at web BUILD time, not API runtime. For split-origin deploys (API and SPA on
# different hostnames), set these in apps/web/.env or export them before
# `npm run build -w @aquazerofit/web`. Leave unset for same-origin (default).
# VITE_API_BASE_URL=https://api.example.com
# VITE_MEDIA_BASE_URL=https://api.example.com