# ============================================================
# AquaZeroFit - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your real keys.
#   cp .env.example .env
#
# Staging and production use separate templates (never share DATABASE_URL,
# JWT, bots, Turnstile, or Play credentials across environments):
#   .env.staging.example
#   .env.production.example
# See docs/BRANCHING_AND_STAGING.md for the feature -> staging -> main path.
#
# NEVER commit your real .env file. It is gitignored.
# ============================================================

# --- App Runtime ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins.
# REQUIRED in production, must be https, and must not contain "*".
# The API refuses to boot otherwise (platform/bootGuards.ts assertProductionSecrets).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Proxy hops to trust for req.ip / X-Forwarded-For.
# 0 locally (no proxy). Behind Azure Container Apps / App Service ingress use 1,
# and 2 if Front Door sits in front of that. Getting this wrong collapses every
# caller into one rate-limit bucket and locks out all logins.
# Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Shared secret the Cloudflare Worker sends as X-Origin-Shared-Secret.
# The API trusts CF-Connecting-IP for rate limits only when the header matches.
# Set the same value on Cloud Run and with `wrangler secret put` (see the PR
# operator steps, or the comment in cloudflare/wrangler.jsonc). Never commit it.
# Boot is refused when it is set to a replace-with-... placeholder or anything
# under 32 characters (`openssl rand -hex 32`), whether or not the gate below is on.
# ORIGIN_SHARED_SECRET=
# true (or 1) refuses every request that lacks that header with 403, closing the
# direct run.app route; /health and /ready stay open for probes. Off by default.
# Boot is refused when it is on and ORIGIN_SHARED_SECRET is empty, and when it
# is anything but true/1/false/0. Flip it only after the runbook in
# docs/OPERATIONS.md ("Closing the run.app bypass").
# REQUIRE_ORIGIN_SECRET=false
# Only during a rotation of ORIGIN_SHARED_SECRET: the old value, accepted beside
# the new one until the Worker has switched, so the gate never comes off. Same
# boot rules as the current value. Remove it as soon as the Worker sends the new
# one; while it is set the old value still opens the origin.
# ORIGIN_SHARED_SECRET_PREVIOUS=
# Launch caps. Per-IP and per-/24 stay on. 0 disables the process-local daily ceiling.
# TELEGRAM_SIGNUP_PER_IP_PER_MINUTE=5
# TELEGRAM_SIGNUP_SUBNET_DAILY=2000
# TELEGRAM_SIGNUP_GLOBAL_DAILY=0
# AUTH_RATE_LIMIT_PER_MINUTE=60
# Stamped by CI (commit SHA) and returned by /health and /ready.
# APP_VERSION=
# Local JSON store directory (default: apps/api/.data).
# Used ONLY when DATABASE_URL is unset. Never rely on this in a hosted
# environment: a managed host's filesystem is reset on every deploy.
# AZF_DATA_DIR=

# --- Persistence ---
# Postgres connection string. A managed host normally injects this for you once
# you attach a database to the app; setting it switches the store from JSON
# files to Postgres. Development and production use SEPARATE databases.
# Leave blank locally to keep using the JSON store.
DATABASE_URL=
# Production on Cloud Run does not use the instance public IP. The connector
# mounts a unix socket, and the API accepts that socket as a local transport
# (plaintext on the socket is correct; sslmode is not required):
#   postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Live shape, password already stored in Secret Manager secret DATABASE_URL:
#   user azf, database aquazerofit, host /cloudsql/aquazerofit:australia-southeast1:azf-pg
# URL-encode reserved characters in the password. Do not authorize 0.0.0.0/0.
# A public-IP URL without TLS is refused at boot. See docs/CLOUDFLARE_CUTOVER.md.

# --- Docker Compose stack (docker-compose.yml) ---
# Required by docker compose up - the stack REFUSES to start when these are
# unset. DATABASE_URL is assembled from these inside compose; do not also set
# DATABASE_URL above when running the compose stack.
POSTGRES_USER=postgres
# Placeholder ONLY - replace with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=aquazerofit

# --- Single-origin hosting ---
# The API also serves the built SPA from apps/web/dist, so one deployment
# serves the whole product on one port and one domain. Set SERVE_WEB=false for
# an API-only deployment; WEB_DIST_DIR overrides where the build is found.
# SERVE_WEB=true
# WEB_DIST_DIR=
# Seed demo data on first boot (set to false to skip)
AZF_SEED_DEMO=true
# Echo password-reset tokens in API responses and server logs (dev only).
# Requires NODE_ENV != production AND EXPOSE_DEV_TOKENS=true. Default off so
# staging never leaks reset credentials via logs or response bodies.
# EXPOSE_DEV_TOKENS=false
# Where in-flight meal photographs are written (default apps/api/uploads).
# On a host with an ephemeral filesystem (a managed host resets it on deploy)
# point this at a mounted persistent volume, or a redeploy loses photos that
# are mid-analysis.
# UPLOADS_DIR=

# --- Mail (REQUIRED in production) ---
# Password reset mints a token and mails it. Without a real transport the token
# goes nowhere, the endpoint still answers 202, and a user who forgets their
# password is locked out for good, so the API refuses to boot in production
# until these are set (platform/bootGuards.ts assertProductionSecrets).
#
# Transport selection: MAIL_PROVIDER if set, else `memory` under test, else
# `resend` when RESEND_API_KEY is present, else `console` (prints the message).
# MAIL_PROVIDER=console
# API key from https://resend.com. Its presence selects the resend transport.
RESEND_API_KEY=
# Envelope sender. MUST be a domain verified with the provider, or every
# message is silently dropped on the provider's side.
MAIL_FROM=AquaZeroFit <no-reply@localhost>
# Public origin of the app; reset links in mail are built from it, and GET
# requests to www.<its host> are 301-redirected to it (platform/https.ts).
APP_PUBLIC_URL=http://localhost:5173
# Public support mailbox shown on the legal pages and in the bot's /paysupport
# reply. Not a secret. The web build reads this same variable. Unset uses
# info@luminara.digital, the address already published for the operator.
# SUPPORT_EMAIL=info@luminara.digital
# Optional LLM second stage for input guardrails (P-09 safetyCheap lane).
# Defaults ON when any AI provider is configured (a key, or OLLAMA_BASE_URL for a
# self-hosted Ollama), OFF otherwise.
# Set true|false to override (platform/config.ts enableLlmSafety).
# ENABLE_LLM_SAFETY=

# --- Security (REQUIRED in production) ---
# Generate with: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
# Admin account for the production seed. BOTH are REQUIRED to create it in
# production; no default is used there. ADMIN_EMAIL must be a mailbox you
# control: the seeder refuses any address on aquazero.fit, which this project
# does not own.
# In development, seeds demo + admin when AZF_SEED_DEMO is not false and
# ADMIN_PASSWORD is set; the admin address defaults to admin@aquazero.fit
# locally. Never commit a real production password here.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Telegram bot token for Mini App launch-data validation. Also the credential
# the Stars payment flow uses: coach purchases stay switched off (the roster
# reports starsAvailable=false and the buy buttons never render) while this is
# the dev placeholder, because calling Telegram with it would 401 on every call.
TELEGRAM_BOT_TOKEN=dev-bot-token

# Shared secret Telegram echoes back on every webhook delivery, set via the
# `secret_token` parameter of setWebhook. REQUIRED before coach purchases can
# complete: /api/v1/telegram/webhook is unauthenticated and grants entitlements,
# so it rejects every request while this is empty rather than trusting them all.
# Generate one with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# Whole Stars for one 30-day (2592000 second) Premium subscription in the Mini
# App. Unset, empty, or not a positive whole number means the plan page stays
# on "not available" and POST /billing/stars/subscription does not call
# Telegram. There is no default price.
# TELEGRAM_STARS_PREMIUM_PRICE=

# ---------------------------------------------------------------------------
# Fight Record and Fight Camp (AZF-W3-05, AZF-P1). Everything ships dark.
# ---------------------------------------------------------------------------
# Master switch for seasons, belts and every Fight Camp feature below. Off
# unless exactly "true" or "1"; turning it off again is the kill switch.
# FIGHT_RECORD_ENABLED=false
# Share of users inside the rollout, 0-100, by stable hash of the user id.
# Unset means 100 (the master switch alone decides); unparseable means 0.
# FIGHT_RECORD_ROLLOUT_PERCENT=
# Fight Camp sub-flags. Each needs the master switch and the rollout bucket
# too. Off unless "true" or "1". Turn on one at a time, at least 7 days apart.
# FC_ENROL_ENABLED=false       # season enrolment and the season recap
# FC_SQUADS_ENABLED=false      # squads, Squad Corner, belts in squads
# FC_CHEERS_ENABLED=false      # cheers and the 1-a-day bot nudge
# FC_GRACE_ENABLED=false       # Cut Man grace days (earned, never sold)
# FC_SHARE_KIT_ENABLED=false   # share cards, share links, referral counts
# FC_GIFTING_ENABLED=false     # gift a week of Premium in Stars (Mini App)
# Treatment share for automated coach cheers in week 1, 0-100. Default 0.
# FC_EARLY_CHEERS_PERCENT=0
# Whole Stars for a gifted week of Premium. No default: unset hides gifting.
# GIFT_PREMIUM_7D_STARS=
# Key for hashing Telegram group ids (chat_instance). At least 32 characters;
# unset or shorter disables Squad Corner. Generate with: openssl rand -hex 32
# ENGAGE_HMAC_SECRET=

# HTTPS URL the /start button opens as a Mini App. Defaults to APP_PUBLIC_URL.
# Keep the exact URL registered in BotFather, including a trailing slash.
# TELEGRAM_MINI_APP_URL=https://aquazerofit.com/
# Optional overrides for the /terms reply. Defaults are pages on APP_PUBLIC_URL.
# The mailbox is SUPPORT_EMAIL above. The refund link defaults to /refund.
# TERMS_URL=https://aquazerofit.com/terms
# PRIVACY_URL=https://aquazerofit.com/privacy
# REFUND_URL=https://aquazerofit.com/refund
# ACCOUNT_DELETION_URL=https://aquazerofit.com/account/deletion

# Refuse plaintext http and redirect it to https (platform/https.ts).
# On by default in production, off otherwise. There is no TLS on localhost.
# Set false ONLY when a sidecar has already terminated TLS and this container
# genuinely serves plaintext on a private network, where redirecting to https
# would point at an origin that does not listen.
# FORCE_HTTPS=

# --- Bot protection (Cloudflare Turnstile) ---
# Guards POST /auth/register and POST /auth/password-reset/request, the two
# unauthenticated routes a botnet actually wants (one mints accounts and AI
# credits, the other mails an address the caller chose). Rate limiting alone
# does not stop a distributed signup flood: a thousand addresses each stay
# under the per-IP lane. Sign-in is deliberately NOT challenged.
#
# BOTH are read by the API at runtime. The site key is public and is handed to
# the browser by GET /api/v1/auth/captcha, deliberately NOT a VITE_ build-time
# constant, because a build-time key is missed silently (the widget simply
# never renders and the form ships unprotected) and cannot be rotated without
# rebuilding the client.
# Keys: https://dash.cloudflare.com -> Turnstile -> Add site
#
# Setting only ONE leaves protection OFF and logs `bot_protection_half_configured`.
# That is deliberate: a secret without a site key would make the server demand a
# token the browser is never told to produce, locking everyone out of signup.
# Both unset disables the check entirely: what development, the test suite and
# the keyless offline demo need.
#
# The API REFUSES TO BOOT in production unless BOTH are set (assertProductionSecrets
# in apps/api/src/platform/config.ts). Off means assertHuman does nothing, so
# registration and password-reset request go out unchallenged while every
# response and log line looks the same as when the check is working, and half
# a pair is the state an operator actually reaches, which is why the guard names
# whichever key is missing rather than just complaining that protection is off.
#
# Turnstile scopes a site key to the hostnames listed on the widget in the
# Cloudflare dashboard. Add every origin that serves the form: the production
# domain AND any preview/dev URL the host issues. Otherwise the widget fails on the
# ones you left out.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# --- Mobile registration path ---
# The native Android client has no browser in its signup flow, so it cannot
# render a Turnstile widget. These three settings govern how it gets through
# the challenge on /auth/register and /auth/password-reset/request.
#
# Waive the challenge for a request carrying the header `X-Client: android`
# and NO captcha token. Read this before switching it on: `X-Client` is typed
# by the caller, not proven, so this is a GLOBAL bypass of the signup
# challenge available to anyone who sends the header. It is not "trust the app".
# It exists for closed testing, where the tester count is known and the
# alternative is no Android signup at all. Every use is audited as
# `captcha_bypassed_mobile`.
# The API REFUSES TO BOOT in production with this set (assertProductionSecrets
# in platform/config.ts). That is deliberate and is not a bug to work around.
# AUTH_ALLOW_CAPTCHALESS_MOBILE=false
#
# Play Integrity: the durable answer, and the one to use in production. The
# Android client attaches a Google-signed attestation as `integrityToken` in
# the request body; the server decodes it and checks that the app really is
# the Play-recognised build of PLAY_INTEGRITY_PACKAGE_NAME on an unmodified
# device. Both must be set for the check to run at all: a verdict validated
# against the wrong package name is not a check.
# The decode call is not wired yet. The seam in platform/botProtection.ts
# currently reports `not-configured`, and an unconfigured or failing integrity
# check always FALLS THROUGH to the normal Turnstile requirement. It can never
# make the gate weaker than it is without it.
# PLAY_INTEGRITY_ENABLED=false
# PLAY_INTEGRITY_PACKAGE_NAME=fit.aquazero.app

# --- Admin MFA ---
# Require every administrator to hold a confirmed second factor. While this is
# off, an admin who never enrolled is audited and logged on each request and
# then let through anyway, and the admin routes read and edit every account on
# the platform.
# Off is a one-time migration window (deploy -> every admin enrols -> set this),
# so the API REFUSES TO BOOT in production unless it is true
# (assertProductionSecrets in platform/bootGuards.ts). Enrol first: flipping
# it with nobody enrolled locks you out of your own system.
MFA_REQUIRE_ADMIN=false
# How long one step-up keeps the admin router open, in seconds (default 600).
# MFA_STEP_UP_TTL_SECONDS=600

# --- AI Provider Keys ---
# All keys are optional in development - the gateway falls back to a
# deterministic offline engine when no provider keys are configured.
# Put in only the keys you have; the gateway auto-detects which are present.

# Azure OpenAI / Microsoft Foundry (unused / reserved).
# Not read by the gateway. Live providers are Groq, OpenAI, Gemini, NVIDIA,
# and Ollama. Setting these has no effect. See docs/specs/AQF-21 for the
# deployment plan that would wire them later.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Meal-photo model. Default is the vision model on
# https://console.groq.com/docs/vision (qwen/qwen3.8-27b as of 2026-10-24).
# GROQ_MODEL_VISIONPRIMARY=qwen/qwen3.8-27b
# Meal-photo deadline in milliseconds. Default 20000. Chat stays at 12000.
# AI_VISION_DEADLINE_MS=20000

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Deployment-wide ceiling on model tokens per UTC day. 0 or unset = no ceiling.
#
# Every other cost control here is per user (credits, the daily grant, the
# per-minute lanes). This is the only one that bounds the TOTAL, so it is the
# only one that answers "what is the most today can cost me".
#
# Past the ceiling the gateway stops calling providers and serves its offline
# engine instead. The app keeps working. That is the same fallback a total
# provider outage uses, and because the result is flagged degraded, no user is
# charged credits for it either. Watch GET /metrics -> aiBudget for
# `exhausted: true`, which means the app is serving template output on purpose
# rather than being broken.
#
# Set it with headroom: the counter sees what providers report, and a call that
# dies mid-generation spends tokens nobody reports. It is a floor on real
# spend, not an exact meter.
AZF_DAILY_TOKEN_BUDGET=
# ---------------------------------------------------------------------------
# Google Play subscriptions (Android premium)
#
# WITHOUT these the billing routes answer PAYMENT_UNAVAILABLE and grant
# nothing. That asymmetry is deliberate: a missing credential must cost a sale,
# never give one away. A purchase token is an opaque string any caller can
# invent, so it is only ever worth something after Google confirms it.
#
# PLAY_SERVICE_ACCOUNT_JSON: the whole service-account JSON on one line, from a
#   Google Cloud service account granted "View financial data" on the Play
#   Console account and linked to the app. Newlines in the private key may be
#   left escaped as 
.
# PLAY_PACKAGE_NAME: the Android applicationId, e.g. fit.aquazero.app
# PLAY_RTDN_SECRET: your own shared secret, echoed by the Pub/Sub push
#   subscription either as the x-azf-rtdn-secret header or a ?secret= query
#   parameter. Unset means the webhook refuses everything, which is correct for
#   an unauthenticated route that can grant a subscription.
#
#   Renewals do not depend on this: the app re-verifies its purchase token on
#   every start, and a renewed token carries a later expiry, so a period
#   extends whether or not the notification arrived. What only this can do is
#   act PROMPTLY on the endings (a refund, a revocation, an expiry) because
#   those are the events where the app has no reason to come asking. Leaving it
#   unset means a refunded subscriber keeps premium until their paid period
#   runs out on its own.
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=
PLAY_RTDN_SECRET=

# --- Stripe Checkout (web premium) ---
# Read by the API only (apps/api/src/modules/billing/stripe.ts). Checkout is
# offered when STRIPE_SECRET_KEY and STRIPE_PRICE_ID are both set and the
# price is readable; the amount on the plan page comes from Stripe. Staging
# uses test-mode keys (sk_test_), production live keys, and the two sets stay
# disjoint (see docs/BRANCHING_AND_STAGING.md). Never commit either.
#
# STRIPE_WEBHOOK_SECRET is the endpoint's signing secret (whsec_). Unset means
# the webhook refuses everything. Create the endpoint at
#   <APP_PUBLIC_URL>/api/v1/billing/stripe/webhook
# with API version 2025-11-17.clover (the version the API pins) and the events
# invoice.paid, invoice.payment_failed, customer.subscription.deleted,
# charge.refunded, charge.dispute.created and charge.dispute.funds_withdrawn.
# An event left off that list never arrives: a refund or chargeback then
# leaves premium running. docs/OPERATIONS.md lists what each one does.
# No publishable key is needed: the browser is sent to Stripe's hosted page.
#
# The Customer Portal behind "Manage or cancel subscription" on the plan page
# has no env var. Configure it once per mode in the Stripe dashboard:
# Settings -> Billing -> Customer portal, then Save. Test and live modes are
# configured separately; until a mode is saved, POST /billing/stripe/portal
# answers 503 there. Set cancellations to "at end of billing period" so a
# subscriber who cancels keeps the time they paid for: an immediate cancel
# fires customer.subscription.deleted, which ends premium at once.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# NVIDIA NIM / build.nvidia.com API (https://build.nvidia.com/)
NVIDIA_API_KEY=
# NVIDIA NIM base URL (OpenAI-compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama (local or hosted - https://ollama.com)
OLLAMA_API_KEY=
# Base URL for Ollama server (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Set true in production so derived targets include adaptive expenditure (EWMA).
# Requires logged weight + food for at least seven qualifying days per user.
ADAPTIVE_TARGETS=true

# --- Frontend (Vite, apps/web) ---
# Read at web BUILD time, not API runtime. For split-origin deploys (API and SPA on
# different hostnames), set these in apps/web/.env or export them before
# `npm run build -w @aquazerofit/web`. Leave unset for same-origin (default).
# VITE_API_BASE_URL=https://api.example.com
# VITE_MEDIA_BASE_URL=https://api.example.com
#
# Telegram Mini Apps Analytics (Apps Center catalog ranking).
# https://docs.tganalytics.xyz/
# Create the token and analytics identifier in TON Builders / @DataChief_bot.
# Vite inlines both into the Mini App bundle, which is how the SDK is designed
# to receive them. They are still not committed. Leave either one unset and
# the client skips init (no throw). Eng does not hold the token. The image
# build reads them as Docker build-args (apps/api/Dockerfile), not as API
# runtime env. The browser site never loads the SDK.
# VITE_TG_ANALYTICS_TOKEN=
# VITE_TG_ANALYTICS_APP_NAME=

# --- Firebase Auth (web client + API Admin) ---
# Hosting and Auth use Firebase project aquazerofit (.firebaserc, and the
# defaults in apps/web/src/lib/firebase.ts). Android and Telegram keep the
# legacy JWT / refresh / initData paths. Web email/password sign-in uses the
# Firebase Auth SDK only when BOTH VITE_FIREBASE_API_KEY and VITE_FIREBASE_APP_ID
# are set at web build time. When either is unset, the web app falls back to
# POST /auth/login (offline demo / tests). Admin verification initialises
# from a key file, from the three FIREBASE_* fields below, or from
# Application Default Credentials when neither is set. See the Admin SDK
# notes further down.
#
# Comments only. Do not commit an API key or a service-account private key.
# The public ids match the committed web client so a staging build points at
# the same Firebase project the Hosting config already uses.
#
# Client (Vite: apps/web/.env, or export before `npm run build -w @aquazerofit/web`):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=aquazerofit.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=aquazerofit
# VITE_FIREBASE_STORAGE_BUCKET=aquazerofit.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=592686987043
# VITE_FIREBASE_APP_ID=1:592686987043:web:be6c7d84103ebb3d697e96
# VITE_FIREBASE_MEASUREMENT_ID=G-900GD16689
# The Cloud Run image leaves these unset unless passed as Docker build-args,
# so the shipped SPA uses POST /auth/login until Firebase web auth is enabled.
#
# Admin SDK (API runtime). Never commit the JSON.
#
# Resolution order (apps/api/src/platform/firebaseAdmin.ts):
# 1. FIREBASE_SERVICE_ACCOUNT_PATH, a key file. Kept so a mounted JSON key
#    still boots. This is the path to retire.
# 2. FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#    together. A partial set throws. It does not fall through to ADC.
# 3. Otherwise Application Default Credentials via applicationDefault().
#    On Cloud Run that is the runtime service account azf-api. No JSON key.
#    GOOGLE_CLOUD_PROJECT (or GCLOUD_PROJECT), when set, is the project id.
#
# Retire the FIREBASE_ADMIN_JSON secret in GCP. Do not do it from CI, and
# do not run gcloud from a pull request:
# 1. Grant azf-api roles/firebaseauth.admin (Firebase Authentication Admin)
#    on project aquazerofit. That covers ID-token revocation checks,
#    revokeRefreshTokens, and deleteUser. Do not create a new JSON key.
# 2. Deploy this API with the key path and the three FIREBASE_* fields
#    unset, so the process uses ADC. If verification reports a missing
#    project id, set GOOGLE_CLOUD_PROJECT=aquazerofit. It is not a secret.
#    Do not set FIREBASE_PROJECT_ID by itself.
# 3. Confirm a verified sign-in still hydrates, an unverified email is
#    refused with AUTH_EMAIL_UNVERIFIED ("Verify your email first"), and
#    account purge deletes the Firebase user.
# 4. Remove the FIREBASE_ADMIN_JSON secret mount (env var or volume) from
#    the Cloud Run service. Unset FIREBASE_SERVICE_ACCOUNT_PATH,
#    FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY if they came from it.
# 5. Delete the JSON key in IAM, then delete the Secret Manager secret
#    FIREBASE_ADMIN_JSON.
#
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_PROJECT_ID=aquazerofit
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#
# If a service-account private key was ever pasted into chat, email, or git,
# delete that key in Google Cloud IAM before production use. Prefer the
# azf-api service account (steps above) over issuing a replacement JSON key.