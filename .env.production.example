# ============================================================
# AquaZeroFit - Production Environment Template
# ============================================================
# Copy into the production secret store only. Never commit filled values.
# Staging and production MUST use different DATABASE_URL, JWT, mail, bot,
# Turnstile, storage, and Play credentials.
# ============================================================

NODE_ENV=production
AZF_ENV=production
PORT=4000

DATABASE_URL=postgres://aqf_app:replace-me@prod-db.example:5432/aquazerofit

CORS_ORIGINS=https://app.example.com
APP_PUBLIC_URL=https://app.example.com
TRUST_PROXY=1
AZF_SEED_DEMO=false
EXPOSE_DEV_TOKENS=false
MFA_REQUIRE_ADMIN=true
AUTH_ALLOW_CAPTCHALESS_MOBILE=false
FORCE_HTTPS=true

JWT_ACCESS_SECRET=replace-with-production-only-secret
TELEGRAM_BOT_TOKEN=replace-with-production-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-production-webhook-secret
ADMIN_PASSWORD=replace-with-strong-admin-password

MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-production-resend-key
MAIL_FROM=AquaZeroFit <no-reply@example.com>

TURNSTILE_SECRET_KEY=replace-with-production-turnstile-secret
TURNSTILE_SITE_KEY=replace-with-production-turnstile-site-key

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
AZF_DAILY_TOKEN_BUDGET=

PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=fit.aquazero.app
PLAY_RTDN_SECRET=

# Frontend build-time (apps/web)
# VITE_API_BASE_URL=
# VITE_MEDIA_BASE_URL=
