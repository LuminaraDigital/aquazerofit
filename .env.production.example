# ============================================================
# AquaZeroFit - Production Environment Template
# ============================================================
# Copy into the production secret store only. Never commit filled values.
# Staging and production MUST use different DATABASE_URL, JWT, mail, bot,
# Turnstile, storage, and Play credentials.
# ============================================================

NODE_ENV=production
AZF_ENV=production
PORT=4000

# Cloud Run connector socket. `replace-me` is a placeholder, not a live password.
# URL-encode reserved characters. Do not point this at the public IP, and do
# not authorize 0.0.0.0/0. The deployed service reads Secret Manager instead
# of this file. See docs/CLOUDFLARE_CUTOVER.md.
DATABASE_URL=postgres://azf:replace-me@/aquazerofit?host=/cloudsql/aquazerofit:australia-southeast1:azf-pg

CORS_ORIGINS=https://aquazerofit.com
APP_PUBLIC_URL=https://aquazerofit.com
# Public support mailbox. Not a secret. Unset uses info@luminara.digital.
# SUPPORT_EMAIL=info@luminara.digital
# One hop while Cloudflare DNS is grey-cloud in front of Cloud Run. Set 2 only
# after an orange-cloud proxy is actually in front. See docs/CLOUDFLARE_CUTOVER.md.
TRUST_PROXY=1
# Same value as the Worker secret from `wrangler secret put ORIGIN_SHARED_SECRET`.
# Placeholder only. Store it in Secret Manager on Cloud Run, not in this file.
ORIGIN_SHARED_SECRET=replace-with-production-only-origin-secret
AZF_INSTANCE_COUNT=1
AZF_SEED_DEMO=false
EXPOSE_DEV_TOKENS=false
MFA_REQUIRE_ADMIN=true
AUTH_ALLOW_CAPTCHALESS_MOBILE=false
FORCE_HTTPS=true

JWT_ACCESS_SECRET=replace-with-production-only-secret
TELEGRAM_BOT_TOKEN=replace-with-production-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-production-webhook-secret
# TELEGRAM_MINI_APP_URL=https://aquazerofit.com/
# TERMS_URL=https://aquazerofit.com/terms
# PRIVACY_URL=https://aquazerofit.com/privacy
# REFUND_URL=https://aquazerofit.com/refund
# ACCOUNT_DELETION_URL=https://aquazerofit.com/account/deletion
ADMIN_EMAIL=replace-with-an-admin-mailbox-you-control
ADMIN_PASSWORD=replace-with-strong-admin-password

MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-production-resend-key
MAIL_FROM=AquaZeroFit <no-reply@aquazerofit.com>

TURNSTILE_SECRET_KEY=replace-with-production-turnstile-secret
TURNSTILE_SITE_KEY=replace-with-production-turnstile-site-key

# At least one AI provider key. With none, every AI answer comes from the
# offline template engine, is never billed, and boot logs ai_provider_unconfigured.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
AZF_DAILY_TOKEN_BUDGET=

PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=fit.aquazero.app
PLAY_RTDN_SECRET=

# Stripe LIVE keys only (sk_live_), never staging's. Leave unset until staging
# has soaked: unset means no checkout is offered, never a dead button.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Stars Premium price for the Mini App. Leave unset until a price is chosen.
# No default. See .env.example.
# TELEGRAM_STARS_PREMIUM_PRICE=

# Frontend build-time (apps/web)
# VITE_API_BASE_URL=
# VITE_MEDIA_BASE_URL=
