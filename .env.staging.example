# ============================================================
# AquaZeroFit - Staging Environment Template
# ============================================================
# Copy to a host secret store or local `.env.staging` (gitignored).
# NEVER point staging at production DATABASE_URL, storage, or API keys.
# ============================================================

NODE_ENV=production
# Staging keeps production-shaped boot guards, but uses isolated secrets.
AZF_ENV=staging
PORT=4000

# Isolated Postgres (sandbox). Never reuse the production connection string.
# Do not point staging at Cloud SQL instance azf-pg or database aquazerofit.
# That instance is the only one in project aquazerofit. Staging stays blocked
# until a second database or instance exists. See docs/CLOUDFLARE_CUTOVER.md.
DATABASE_URL=postgres://aqf_staging:replace-me@staging-db.example:5432/aquazerofit_staging

CORS_ORIGINS=https://staging.example.com
APP_PUBLIC_URL=https://staging.example.com
# Public support mailbox. Not a secret. Unset uses info@luminara.digital.
# SUPPORT_EMAIL=info@luminara.digital
TRUST_PROXY=1
# Same value as the Worker secret from `wrangler secret put ORIGIN_SHARED_SECRET`.
# Placeholder only. Unset means every caller shares the socket address for rate limits.
ORIGIN_SHARED_SECRET=replace-with-staging-only-origin-secret
# Required on Cloud Run: boot refuses an unset value there. See docs/OPERATIONS.md.
AZF_INSTANCE_COUNT=1
AZF_SEED_DEMO=false
EXPOSE_DEV_TOKENS=false
MFA_REQUIRE_ADMIN=true
AUTH_ALLOW_CAPTCHALESS_MOBILE=false

JWT_ACCESS_SECRET=replace-with-staging-only-secret
TELEGRAM_BOT_TOKEN=replace-with-staging-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-staging-webhook-secret
# TELEGRAM_MINI_APP_URL=https://staging.example.com/
# TERMS_URL=https://staging.example.com/terms
# PRIVACY_URL=https://staging.example.com/privacy
# REFUND_URL=https://staging.example.com/refund
# ACCOUNT_DELETION_URL=https://staging.example.com/account/deletion

MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-staging-resend-key
MAIL_FROM=AquaZeroFit Staging <no-reply@staging.example.com>

TURNSTILE_SECRET_KEY=replace-with-staging-turnstile-secret
TURNSTILE_SITE_KEY=replace-with-staging-turnstile-site-key

# Prefer sandbox / non-billable AI keys. Empty is fine: offline engine covers demos.
# Staging runs NODE_ENV=production, so with these blank AI answers deliberately cost no credits.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Staging Play billing must use a license-test package or stay unset
# (PAYMENT_UNAVAILABLE is safer than granting real entitlements).
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=
PLAY_RTDN_SECRET=

# Stripe TEST mode only on staging (sk_test_). Webhook endpoint and its whsec_
# belong to this environment alone; see .env.example for the endpoint setup.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Stars Premium price for the Mini App. Leave unset until a price is chosen.
# No default. See .env.example.
# TELEGRAM_STARS_PREMIUM_PRICE=

# Frontend build-time (apps/web)
# VITE_API_BASE_URL=https://staging.example.com
# VITE_MEDIA_BASE_URL=https://staging.example.com
