node_modules/
dist/
build/
coverage/
*.local

# Secrets - never commit environment files with real keys
.env
.env.*
!.env.example

# AI coding-assistant workspaces. These are developer-local scratch state, not
# product code. Previously clean only because of a machine-local global ignore,
# which does not travel with a clone.
.claude/
.cursor/
.windsurf/
.aider*

# Editors
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Microsoft Office lock/owner files, created whenever a .docx in docs/specs is
# open in Word. They are transient local state, not deliverables.
~$*

# App data & uploads (runtime-generated)
apps/api/.data/
apps/api/uploads/
*.tsbuildinfo

# Logs & tool caches
*.log
npm-debug.log*
.vite/
.turbo/
node_modules/.cache/

# Generated documents at root — regenerate with tools/docgen.
# Anchored so the deliverable set in docs/specs/ is still tracked.
/*.docx
docker-compose.override.yml

# Android (apps/android) — Gradle build outputs and local machine state.
# Source, wrapper and exported Room schemas stay tracked.
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.kotlin/
apps/android/captures/
*.apk
*.aab
*.jks
*.keystore
