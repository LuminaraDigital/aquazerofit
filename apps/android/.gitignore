# Gradle build outputs. Unanchored so every module (:app, :core:*, :feature:*)
# and build-logic/ is covered, not just the root.
build/
.gradle/
.kotlin/
*.iml

# Machine-local SDK location — generated by Android Studio on first open.
local.properties

# Release signing material. The keystore itself never enters version control;
# CI injects it from secrets and keystore.properties.template documents the
# expected shape. See docs/PLAY_STORE_RELEASE_GUIDE.md.
keystore.properties
*.jks
*.keystore
*_keystore*.txt

# Build artefacts
*.apk
*.aab
/captures/
.externalNativeBuild/
.cxx/

# IDE
/.idea/

# OS
.DS_Store
