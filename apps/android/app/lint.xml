<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project lint configuration.

  This file is deliberately NOT a baseline: every issue lint reports against
  this project's own sources is fixed in the sources. The one entry below
  excludes a file that is not part of the project at all.
-->
<lint>
    <!--
      `local.properties` is generated by Android Studio, is gitignored, and
      holds whatever absolute SDK path the current machine happens to use. On
      Windows that path contains `\` and `C:`, which PropertyEscape flags. It
      is machine-local state, not source we ship, and "fixing" it would just be
      overwritten by the IDE on the next sync — and would differ per developer.
      The check stays enabled everywhere else.
    -->
    <issue id="PropertyEscape">
        <ignore regexp="local\.properties" />
    </issue>
</lint>
