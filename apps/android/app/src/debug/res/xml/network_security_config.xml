<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override: permit cleartext to the Android emulator's host
     loopback (10.0.2.2) so the app can reach the local dev API. Everything
     else stays TLS-only, matching the release config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
