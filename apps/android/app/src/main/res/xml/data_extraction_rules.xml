<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup & device-transfer rules. The auth DataStore (encrypted
     refresh token + IV) never leaves the device: the AES key lives in the
     hardware Keystore and cannot be backed up, so the ciphertext is useless
     off-device and a credential should not travel anyway.

     The wellness cache (`azf.db`) is excluded from BOTH destinations, not
     just cloud backup: device transfer is a direct device-to-device copy
     with no Google servers in the path, but it still moves a full set of
     meals, chat turns and profile data onto hardware the rows were never
     written on, and the session that would have identified their owner is
     excluded from the same transfer.

     The sidecars go with the database because they hold the same rows:
     -wal/-shm are the WAL pair Room uses by default, and -journal is the
     rollback journal Room falls back to when WAL is unavailable (AUTOMATIC
     journal mode drops to TRUNCATE on low-RAM devices), holding pre-images
     of modified pages. Excluding a file that does not exist costs nothing,
     so both journalling schemes are covered rather than only the expected
     one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/azf_auth.preferences_pb" />
        <exclude domain="database" path="azf.db" />
        <exclude domain="database" path="azf.db-wal" />
        <exclude domain="database" path="azf.db-shm" />
        <exclude domain="database" path="azf.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/azf_auth.preferences_pb" />
        <exclude domain="database" path="azf.db" />
        <exclude domain="database" path="azf.db-wal" />
        <exclude domain="database" path="azf.db-shm" />
        <exclude domain="database" path="azf.db-journal" />
    </device-transfer>
</data-extraction-rules>
