    "audit:exercise-media": "tsx scripts/auditExerciseMedia.ts",
    "import:wger": "tsx scripts/wgerImport.ts",
    "import:off": "tsx scripts/offImport.ts"
  },
  "dependencies": {
    "@aquazerofit/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "sharp": "^0.35.2",
    "tsx": "^4.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
