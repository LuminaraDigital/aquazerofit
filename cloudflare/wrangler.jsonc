{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aquazerofit",
  "account_id": "2373013c66331e9660e47ffa3ae40f5c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "API_ORIGIN": "https://aquazerofit-api-592686987043.australia-southeast1.run.app"
  },
  // ORIGIN_SHARED_SECRET is a Worker secret, not a var. Set it with
  // `npx wrangler secret put ORIGIN_SHARED_SECRET` from this directory.
  // The same value goes on the API as ORIGIN_SHARED_SECRET. Never commit it.
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "aquazerofit.com", "custom_domain": true },
    { "pattern": "www.aquazerofit.com", "custom_domain": true }
  ]
}
